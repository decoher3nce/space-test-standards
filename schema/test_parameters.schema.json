{
  "$defs": {
    "Citation": {
      "additionalProperties": false,
      "description": "Where a value comes from. Clause and table are the durable anchors; page numbers\nare a convenience and are given for the public PDF named in the standard record.",
      "properties": {
        "standard": {
          "description": "Library id of the standard, e.g. gevs-7000b",
          "title": "Standard",
          "type": "string"
        },
        "clause": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Clause or paragraph, e.g. 2.2.4",
          "title": "Clause"
        },
        "table": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Table designation as printed",
          "title": "Table"
        },
        "figure": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Figure"
        },
        "page": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Printed page label, e.g. '2.2 - 5'",
          "title": "Page"
        },
        "pdf_page": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "1-based page index in the public PDF",
          "title": "Pdf Page"
        },
        "note": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Note"
        }
      },
      "required": [
        "standard"
      ],
      "title": "Citation",
      "type": "object"
    },
    "Level": {
      "description": "Unified level of assembly (GEVS Table 2.2-1 lineage).",
      "enum": [
        "part",
        "subassembly",
        "unit",
        "subsystem",
        "element",
        "segment",
        "system"
      ],
      "title": "Level",
      "type": "string"
    },
    "ParameterSet": {
      "additionalProperties": false,
      "description": "Levels and durations for one regime.",
      "properties": {
        "level": {
          "anyOf": [
            {
              "$ref": "#/$defs/Quantity"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "duration": {
          "anyOf": [
            {
              "$ref": "#/$defs/Quantity"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "cycles": {
          "anyOf": [
            {
              "$ref": "#/$defs/Quantity"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "margin": {
          "anyOf": [
            {
              "$ref": "#/$defs/Quantity"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "sweep_rate": {
          "anyOf": [
            {
              "$ref": "#/$defs/Quantity"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "actuations": {
          "anyOf": [
            {
              "$ref": "#/$defs/Quantity"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "axes": {
          "anyOf": [
            {
              "$ref": "#/$defs/Quantity"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "dwell": {
          "anyOf": [
            {
              "$ref": "#/$defs/Quantity"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "rate": {
          "anyOf": [
            {
              "$ref": "#/$defs/Quantity"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "temperature_range": {
          "anyOf": [
            {
              "$ref": "#/$defs/Quantity"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "extra": {
          "additionalProperties": {
            "$ref": "#/$defs/Quantity"
          },
          "title": "Extra",
          "type": "object"
        },
        "footnotes": {
          "items": {
            "type": "string"
          },
          "title": "Footnotes",
          "type": "array"
        },
        "notes": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Notes"
        }
      },
      "title": "ParameterSet",
      "type": "object"
    },
    "Quantity": {
      "additionalProperties": false,
      "description": "A numeric or textual value with an explicit unit and reference.\n\nExamples: level 3 dB relative to limit_level; duration 1 min per axis; cycles 4;\nmargin 10 degC relative to max_min_predicted. When a standard prints words rather\nthan a number (\"As specified for mission\") use `text` and leave value empty.",
      "properties": {
        "value": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Value"
        },
        "min_value": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Min Value"
        },
        "max_value": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Max Value"
        },
        "unit": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "dB | factor | min | min_per_axis | s | hr | cycles | degC | degC_per_min | oct_per_min | actuations | axes | grms | g2_per_hz | db_oaspl | percent | count | text",
          "title": "Unit"
        },
        "relative_to": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "limit_level | limit_load | max_predicted | min_predicted | acceptance_level | mpe | qualification_level | design_range | none",
          "title": "Relative To"
        },
        "per": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "axis | cycle | plateau | side | model",
          "title": "Per"
        },
        "text": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Value as printed when not numeric",
          "title": "Text"
        },
        "note": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Note"
        }
      },
      "title": "Quantity",
      "type": "object"
    },
    "Regime": {
      "description": "Unified test regime. Standards use different words for similar ideas; the\nterminology map in the library records the local word and the local factors.",
      "enum": [
        "qualification",
        "protoflight",
        "acceptance",
        "development",
        "all"
      ],
      "title": "Regime",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "kind": {
      "const": "test_parameters",
      "title": "Kind",
      "type": "string"
    },
    "id": {
      "pattern": "^[a-z0-9][a-z0-9._-]*$",
      "title": "Id",
      "type": "string"
    },
    "standard": {
      "title": "Standard",
      "type": "string"
    },
    "test_type": {
      "title": "Test Type",
      "type": "string"
    },
    "variant": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Variant"
    },
    "title": {
      "title": "Title",
      "type": "string"
    },
    "citation": {
      "$ref": "#/$defs/Citation"
    },
    "level_of_assembly": {
      "anyOf": [
        {
          "items": {
            "$ref": "#/$defs/Level"
          },
          "type": "array"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Level Of Assembly"
    },
    "hardware_type": {
      "anyOf": [
        {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Hardware Type"
    },
    "flags": {
      "description": "Node flags that must all be present for this record to apply (GEVS cryogenic parameters need `cryogenic`)",
      "items": {
        "type": "string"
      },
      "title": "Flags",
      "type": "array"
    },
    "by_regime": {
      "additionalProperties": {
        "$ref": "#/$defs/ParameterSet"
      },
      "propertyNames": {
        "$ref": "#/$defs/Regime"
      },
      "title": "By Regime",
      "type": "object"
    },
    "footnotes": {
      "additionalProperties": {
        "type": "string"
      },
      "title": "Footnotes",
      "type": "object"
    },
    "confidence": {
      "default": "verified",
      "enum": [
        "verified",
        "deck_only",
        "secondary",
        "needs_check"
      ],
      "title": "Confidence",
      "type": "string"
    },
    "notes": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Notes"
    }
  },
  "required": [
    "kind",
    "id",
    "standard",
    "test_type",
    "title",
    "citation",
    "by_regime"
  ],
  "title": "TestParameters",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/decoher3nce/space-test-standards/schema/test_parameters.schema.json"
}
