{
  "$defs": {
    "VocabularyEntry": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$",
          "title": "Id",
          "type": "string"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "description": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Description"
        },
        "parent": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Parent"
        },
        "aliases": {
          "additionalProperties": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "items": {
                  "type": "string"
                },
                "type": "array"
              }
            ]
          },
          "description": "standard id -> label(s) used by that standard",
          "title": "Aliases",
          "type": "object"
        },
        "tags": {
          "items": {
            "type": "string"
          },
          "title": "Tags",
          "type": "array"
        },
        "attributes": {
          "additionalProperties": true,
          "title": "Attributes",
          "type": "object"
        }
      },
      "required": [
        "id",
        "name"
      ],
      "title": "VocabularyEntry",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "kind": {
      "const": "vocabulary",
      "title": "Kind",
      "type": "string"
    },
    "vocabulary": {
      "enum": [
        "test_type",
        "level_of_assembly",
        "hardware_type",
        "regime",
        "requirement_code",
        "method",
        "discipline",
        "model",
        "flag",
        "facility_class"
      ],
      "title": "Vocabulary",
      "type": "string"
    },
    "description": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Description"
    },
    "entries": {
      "items": {
        "$ref": "#/$defs/VocabularyEntry"
      },
      "title": "Entries",
      "type": "array"
    }
  },
  "required": [
    "kind",
    "vocabulary",
    "entries"
  ],
  "title": "Vocabulary",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/decoher3nce/space-test-standards/schema/vocabulary.schema.json"
}
